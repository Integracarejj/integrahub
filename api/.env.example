PORT=4000

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=

# Optional: separate Graph credentials (falls back to AZURE_* vars if not set)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# Dedicated backend-only SharePoint integration identity (required for SharePoint health check)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Optional target overrides
# SHAREPOINT_WORKING_HOSTNAME=integracare.sharepoint.com
# SHAREPOINT_WORKING_SITE_PATH=/sites/tIntegraSourceWorking
# SHAREPOINT_WORKING_LIBRARY=Recapitalization Working
# SHAREPOINT_EXTERNAL_HOSTNAME=integracare.sharepoint.com
# SHAREPOINT_EXTERNAL_SITE_PATH=/sites/ICC_External
# SHAREPOINT_EXTERNAL_LIBRARY=Documents

# Optional: allow write test in graph diagnostics (default false)
# GRAPH_DIAGNOSTICS_ALLOW_WRITE=true
